<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ display_title }}</title>
    <link rel="stylesheet" href="style.css">
    <script>(function(){var t=localStorage.getItem('ossip-theme');if(t==='light')document.documentElement.setAttribute('data-theme','light');})();</script>
</head>

<body>
    <h1>{{ display_title }}</h1>
    <div class="nav-bar">
        <div class="nav-item"><a href="index.html">Back to OSSIP</a></div>
        <div class="nav-item">GitHub Repository: <a href="https://github.com/tomncooper/ossip">tomncooper/ossip</a></div>
        <div class="nav-item">Last Updated: {{ date }}</div>
    </div>

    <!-- Filter Controls -->
    <div id="filter-controls"></div>

    <table>
        <thead>
        <tr>
            <th>{{ prefix }}</th>
            <th>Title</th>
            <th>State</th>
            <th>Status</th>
            <th>Author(s)</th>
            <th>Created</th>
            <th>Accepted</th>
            <th>Commented</th>
            <th>Requested Changes</th>
            <th data-nosort>More Info</th>
        </tr>
        </thead>
        <tbody>
        {% set status_rank = {'blue': 0, 'green': 1, 'yellow': 2, 'red': 3, 'black': 4} %}
        {% for row in rows %}
        <tr data-state="{{ row.state|e }}" data-authors='{{ row.authors|tojson }}'>
            <td>{% if row.web_url %}<a href="{{ row.web_url }}">{{ row.display_id }}</a>{% else %}{{ row.display_id }}{% endif %}</td>
            <td>{{ row.title }}</td>
            <td>{{ row.state }}</td>
            {% if row.activity_status %}
            <td style="background-color:{{ row.activity_status }};" data-sort="{{ status_rank[row.activity_status] }}">
                <div class="tooltip">&nbsp;
                    <span class="tooltiptext">{% if row.last_activity_age %}Last activity {{ row.last_activity_age }} ago{% else %}No activity recorded{% endif %}</span>
                </div>
            </td>
            {% else %}
            <td style="text-align: center; font-size: 1.5em;">{{ row.emoji }}</td>
            {% endif %}
            <td class="author-cell">{{ row.authors|join(", ") }}</td>
            <td>{{ row.created_on }}</td>
            {% for column, css_class in [("accepted", "vote-positive"), ("commented", "vote-neutral"), ("changes_requested", "vote-negative")] %}
            {% set users = row.reviews[column] %}
            {% if users %}
            <td class="{{ css_class }}" style="text-align: center;" data-sort="{{ users|length }}">
                <div class="tooltip">{{ users|length }}
                    <span class="tooltiptext">
                        {% for user in users %}
                        {{ user.name }}<br><em>{{ user.timestamp }}</em><br>
                        {% endfor %}
                    </span>
                </div>
            </td>
            {% else %}
            <td style="text-align: center;">0</td>
            {% endif %}
            {% endfor %}
            <td><a href="{{ row.detail_url }}">info</a></td>
        </tr>
        {% endfor %}
        </tbody>
    </table>

    <!-- Filter JavaScript -->
    <script src="assets/table-filter.js?v=3"></script>
    <script src="assets/table-sort.js?v=1"></script>
    <script>
        TableSort.init({ tableSelector: 'table' });
        TableFilter.init({
            tableSelector: 'table',
            filterContainerId: 'filter-controls',
            columns: [
                { id: 'state', label: 'State', dataAttr: 'data-state' },
                { id: 'author', label: 'Author', dataAttr: 'data-authors', multi: true }
            ],
            search: {
                columns: [0, 1],
                placeholder: 'Search by {{ prefix }} or title...'
            }
        });
    </script>
    {% include '_footer.html' %}
    <script src="assets/theme-toggle.js"></script>
</body>

</html>
