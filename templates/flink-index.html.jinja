<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Apache Flink Improvement Proposals</title>
    <link rel="stylesheet" href="style.css">
    <script>(function(){var t=localStorage.getItem('ossip-theme');if(t==='light')document.documentElement.setAttribute('data-theme','light');})();</script>
</head>

<body>
    <h1>Apache Flink&reg; Improvement Proposals (FLIPs)</h1>
    <div class="nav-bar">
        <div class="nav-item"><a href="index.html">Back to OSSIP</a></div>
        <div class="nav-item">GitHub Repository: <a href="https://github.com/tomncooper/ossip">tomncooper/ossip</a></div>
        <div class="nav-item">Last Updated: {{ date }}</div>
    </div>
    
    <!-- Filter Controls -->
    <div id="filter-controls"></div>
    
    <table>
        <thead>
        <tr>
            <th>FLIP</th>
            <th>Description</th>
            <th>Component</th>
            <th>Target Release</th>
            <th>+1</th>
            <th>0</th>
            <th>-1</th>
            <th>Author(s)</th>
            <th>State</th>
            <th>JIRA</th>
            <th data-nosort>More Info</th>
        </tr>
        </thead>
        <tbody>
        {% for flip in flip_data %}
        {% set authors = flip.get('authors', [flip['created_by']]) %}
        <tr data-state="{{ flip['state']|e }}" data-authors='{{ authors|tojson }}' data-component="{{ flip['release_component']|e }}">
            <td><a href={{ flip['web_url'] }}>{{ flip['id'] }}</a></td>
            <td>{{ flip['title'] }}
            {% if flip["release_component"] == "not set" or flip["release_component"] == "unknown" %}
            <td></td>
            {% else %}
            <td>{{ flip['release_component'] }}
            {% endif %}
            {% if flip["release_version"] == "not set" or flip["release_version"] == "unknown" %}
            <td></td>
            {% else %}
            <td>{{ flip['release_version'] }}
            {% endif %}
            {% if flip["+1"] %}
            <td class="vote-positive" data-sort="{{ flip["+1"]|length }}">
                <div class="tooltip">{{ flip["+1"]|length }}
                    <span class="tooltiptext">
                        {% for voter in flip["+1"] %}
                        {{ voter.name }}<br><em>{{ voter.timestamp }}</em><br>
                        {% endfor %}
                    </span>
                </div>
            </td>
            {% else %}
            <td>{{ flip["+1"]|length }}</td>
            {% endif %}
            {% if flip["0"] %}
            <td class="vote-neutral" data-sort="{{ flip["0"]|length }}">
                <div class="tooltip">{{ flip["0"]|length }}
                    <span class="tooltiptext">
                        {% for voter in flip["0"] %}
                        {{ voter.name }}<br><em>{{ voter.timestamp }}</em><br>
                        {% endfor %}
                    </span>
                </div>
            </td>
            {% else %}
            <td>{{ flip["0"]|length }}</td>
            {% endif %}
            {% if flip["-1"] %}
            <td class="vote-negative" data-sort="{{ flip["-1"]|length }}">
                <div class="tooltip">{{ flip["-1"]|length }}
                    <span class="tooltiptext">
                        {% for voter in flip["-1"] %}
                        {{ voter.name }}<br><em>{{ voter.timestamp }}</em><br>
                        {% endfor %}
                    </span>
                </div>
            </td>
            {% else %}
            <td>{{ flip["-1"]|length }}</td>
            {% endif %}
            <td class="author-cell">{{ authors|join(", ") }}</td>
            <td>{{ flip["state"] }}</td>
            {% if flip["jira_id"] == "not set" %}
            <td></td>
            {% else %}
            <td><a href={{ flip['jira_link'] }}>{{ flip['jira_id'] }}</a></td>
            {% endif %}
            <td><a href=flips/FLIP-{{ flip['id'] }}.html>info</a></td>
        </tr>
        {% endfor %}
        </tbody>
    </table>

    <!-- Filter JavaScript -->
    <script src="assets/table-filter.js?v=3"></script>
    <script src="assets/table-sort.js?v=1"></script>
    <script>
        TableSort.init({ tableSelector: 'table' });
        TableFilter.init({
            tableSelector: 'table',
            filterContainerId: 'filter-controls',
            columns: [
                { id: 'state', label: 'State', dataAttr: 'data-state' },
                { id: 'author', label: 'Author', dataAttr: 'data-authors', multi: true },
                { id: 'component', label: 'Component', dataAttr: 'data-component' }
            ],
            search: {
                columns: [0, 1],
                placeholder: 'Search by FLIP or description...'
            }
        });
    </script>
    {% include '_footer.html' %}
    <script src="assets/theme-toggle.js"></script>
</body>

</html>