<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Apache Kafka Improvement Proposals</title>
    <link rel="stylesheet" href="style.css">
    <script>(function(){var t=localStorage.getItem('ossip-theme');if(t==='light')document.documentElement.setAttribute('data-theme','light');})();</script>
</head>

<body>
    <h1>Apache Kafka&reg; Improvement Proposals (KIPs)</h1>
    <div class="nav-bar">
        <div class="nav-item"><a href="index.html">Back to OSSIP</a></div>
        <div class="nav-item">GitHub Repository: <a href="https://github.com/tomncooper/ossip">tomncooper/ossip</a></div>
        <div class="nav-item">Last Updated: {{ date }}</div>
    </div>
    
    <!-- Filter Controls -->
    <div id="filter-controls"></div>
    
    <table>
        <thead>
        <tr>
            <th>KIP</th>
            <th>Description</th>
            <th>State</th>
            <th>Status</th>
            <th>+1</th>
            <th>0</th>
            <th>-1</th>
            <th>Author(s)</th>
            <th data-sort-reverse>Age</th>
            <th data-nosort>More Info</th>
        </tr>
        </thead>
        <tbody>
        {% set status_rank = {'blue': 0, 'green': 1, 'yellow': 2, 'red': 3, 'black': 4} %}
        {% for kip in kip_status %}
        <tr data-state="{{ kip['state']|e }}" data-authors='{{ kip['authors']|tojson }}'>
            <td><a href={{ kip['url'] }}>{{ kip['id'] }}</a></td>
            <td>{{ kip['text'] }}</td>
            <td>{{ kip['state'] }}</td>
            {% if kip['status'] %}
            <td style="background-color:{{ kip['status'].text }};" data-sort="{{ status_rank[kip['status'].text] }}">
                <div class="tooltip">&nbsp;
                    <span class="tooltiptext">{% if kip['last_mention_age'] %}Last mentioned {{ kip['last_mention_age'] }} ago{% else %}Never mentioned in mailing lists{% endif %}</span>
                </div>
            </td>
            {% else %}
            <td style="text-align: center; font-size: 1.5em;">{{ kip['emoji'] }}</td>
            {% endif %}
            {% if kip["+1"] %}
            <td class="vote-positive" data-sort="{{ kip["+1"]|length }}">
                <div class="tooltip">{{ kip["+1"]|length }}
                    <span class="tooltiptext">
                        {% for voter in kip["+1"] %}
                        {{ voter.name }}<br><em>{{ voter.timestamp }}</em><br>
                        {% endfor %}
                    </span>
                </div>
            </td>
            {% else %}
            <td>{{ kip["+1"]|length }}</td>
            {% endif %}
            {% if kip["0"] %}
            <td class="vote-neutral" data-sort="{{ kip["0"]|length }}">
                <div class="tooltip">{{ kip["0"]|length }}
                    <span class="tooltiptext">
                        {% for voter in kip["0"] %}
                        {{ voter.name }}<br><em>{{ voter.timestamp }}</em><br>
                        {% endfor %}
                    </span>
                </div>
            </td>
            {% else %}
            <td>{{ kip["0"]|length }}</td>
            {% endif %}
            {% if kip["-1"] %}
            <td class="vote-negative" data-sort="{{ kip["-1"]|length }}">
                <div class="tooltip">{{ kip["-1"]|length }}
                    <span class="tooltiptext">
                        {% for voter in kip["-1"] %}
                        {{ voter.name }}<br><em>{{ voter.timestamp }}</em><br>
                        {% endfor %}
                    </span>
                </div>
            </td>
            {% else %}
            <td>{{ kip["-1"]|length }}</td>
            {% endif %}
            <td class="author-cell">{{ kip['authors']|join(", ") }}</td>
            <td data-sort="{{ kip['created_on'] }}">{{ kip["age"] }}</td>
            <td><a href=kips/KIP-{{ kip['id'] }}.html>info</a></td>
        </tr>
        {% endfor %}
        </tbody>
    </table>

    <!-- Filter JavaScript -->
    <script src="assets/table-filter.js?v=3"></script>
    <script src="assets/table-sort.js?v=1"></script>
    <script>
        TableSort.init({ tableSelector: 'table' });
        TableFilter.init({
            tableSelector: 'table',
            filterContainerId: 'filter-controls',
            columns: [
                { id: 'state', label: 'State', dataAttr: 'data-state' },
                { id: 'author', label: 'Author', dataAttr: 'data-authors', multi: true }
            ],
            search: {
                columns: [0, 1],
                placeholder: 'Search by KIP or description...'
            }
        });
    </script>
    {% include '_footer.html' %}
    <script src="assets/theme-toggle.js"></script>
</body>

</html>